---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Tag from '../../components/Tag.astro';
import { getCollection, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id } }));
}

const { slug } = Astro.params;
const post = await getEntry('blog', slug);
if (!post) return Astro.redirect('/blog');

const { Content } = await render(post);
---

<Layout title={`${post.data.title} — PriHues`} description={post.data.description}>
  <article class="section">
    <div class="container article-layout">
      <header class="article-header">
        <div class="article-meta">
          {post.data.tags.map((tag) => (
            <Tag label={tag} color="violet" />
          ))}
          <span class="caption">
            {post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
          </span>
        </div>
        <h1 class="article-title">{post.data.title}</h1>
        <p class="article-desc">{post.data.description}</p>
      </header>
      <div class="prose">
        <Content />
      </div>
      <a href="/blog" class="back-link">← Back to Blog</a>
    </div>
  </article>
</Layout>

<style>
  .article-layout {
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .article-header {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-bottom: 40px;
    border-bottom: 1px solid rgba(9, 9, 14, 0.08);
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .article-title {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 800;
    color: var(--color-dark);
    line-height: 1.1;
  }

  .article-desc {
    font-size: 18px;
    font-weight: 300;
    color: var(--color-muted);
  }

  .prose {
    color: var(--color-muted);
    line-height: 1.8;
    font-size: 17px;
  }

  .prose p { margin-bottom: 1.5em; }
  .prose h2 { color: var(--color-dark); margin: 2em 0 0.75em; }
  .prose h3 { color: var(--color-dark); margin: 1.5em 0 0.5em; }

  .back-link {
    font-family: 'Manrope', sans-serif;
    font-weight: 600;
    font-size: 13px;
    color: var(--color-violet);
  }

  .back-link:hover { opacity: 0.75; }
</style>
